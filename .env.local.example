# Copia este fichero como .env.local y rellena los valores
# (no subir .env.local al repo — ya está en .gitignore)

# === Supabase ===
# Pega aquí los valores de tu proyecto Supabase:
# Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Service role key — SECRETO, solo se usa server-side
SUPABASE_SERVICE_ROLE_KEY="eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# === Anthropic (corrección IA de respuestas escritas) ===
# Pásala desde https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY="sk-ant-api03-..."

# === Admin ===
# Email + password del admin (cambiar en producción)
ADMIN_EMAIL="admin@secretadsacademy.com"
ADMIN_PASSWORD="cambiar-esto-en-produccion"
# Secreto para firmar la cookie de sesión admin
# Genera uno aleatorio largo: openssl rand -base64 48
ADMIN_SESSION_SECRET="cambiar-por-un-secreto-aleatorio-largo"
